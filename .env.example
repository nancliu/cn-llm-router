# cn-llm-router 环境变量模板：复制为 .env 并填入真实 key（.env 已 gitignore，仓库零密钥）
# provider → key_env 映射见 config/providers.example.yaml（缺省即该文件）
# key 获取入口 URL 与全量评测步骤见 docs/eval-setup.md
#
# 说明：以下 7 家为 providers.example.yaml 已注册的 provider；
#       其中火山、阿里为本仓库已实测可用的两家，其余各家按需申请后填入。
#       讯飞星火 X2.5 暂无 provider 条目（base_url/api_model/key_env 待补充），先注释占位。

# 智谱 GLM（GLM-5.3 / 5.3-Flash / 5.2）—— key 获取：https://bigmodel.cn/pricing
ZHIPU_API_KEY=

# 深度求索 DeepSeek（DeepSeek-V4-Pro / V4-Flash）—— key 获取：https://platform.deepseek.com
DEEPSEEK_API_KEY=

# 火山方舟（DeepSeek-V4.1-Flash-CED / 豆包 Seed-2.1-Pro）—— 已配/已实测
# key 获取：https://console.volcengine.com/ark
VOLCENGINE_API_KEY=

# 阿里云百炼（Qwen3.8-Max）—— 已配/已实测
# key 获取：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=

# Kimi（月之暗面，Kimi-K3 / K2.7-Code）—— key 获取：https://platform.kimi.com
MOONSHOT_API_KEY=

# 腾讯混元（混元 Hy3）—— key 获取：https://console.cloud.tencent.com/hunyuan
TENCENT_HUNYUAN_API_KEY=

# MiniMax（MiniMax-M3）—— key 获取：https://platform.minimaxi.com
MINIMAX_API_KEY=

# 讯飞星火（X2.5）：data/models.csv 有评分记录，但 providers.example.yaml 尚未注册
# provider 条目（base_url/api_model/key_env 待补充）；配置就绪后取消下行注释并填值。
# XINGHUO_API_KEY=

# 可选：配置目录覆盖（providers.yaml / classifier.yaml / selector.yaml / weights.yaml）
# CN_LLM_ROUTER_CONFIG=/path/to/my-config
