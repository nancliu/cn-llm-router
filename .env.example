# cn-llm-router 环境变量模板：复制为 .env 并填入真实 key（.env 已 gitignore，仓库零密钥）
# provider → key_env 映射见 config/providers.yaml（缺省用 config/providers.example.yaml）

# 智谱 GLM
ZHIPU_API_KEY=
# 深度求索 DeepSeek
DEEPSEEK_API_KEY=
# 火山方舟（DeepSeek-V4.1 / 豆包 Seed）
VOLCENGINE_API_KEY=
# 阿里云百炼（Qwen）
DASHSCOPE_API_KEY=
# Kimi（月之暗面）
MOONSHOT_API_KEY=
# 腾讯混元
TENCENT_HUNYUAN_API_KEY=
# MiniMax
MINIMAX_API_KEY=

# 可选：配置目录覆盖（providers.yaml / classifier.yaml / selector.yaml / weights.yaml）
# CN_LLM_ROUTER_CONFIG=/path/to/my-config
